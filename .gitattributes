# Check out every text file with LF line endings, on Windows too.
# Shell scripts, Compose files, Dockerfiles and data files then work in Git Bash and inside Linux containers.
* text=auto eol=lf

# Files that are not text: Git must never change their bytes.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.parquet binary
*.pbix binary
*.tar binary
