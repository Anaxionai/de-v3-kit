# Copy this file to dbt/.env and fill in your values. Git ignores .env: never commit it.
# Run dbt from gitpulse/dbt/ with: uv run --env-file .env dbt <command>
# Account identifier, in the form orgname-accountname (see ~/de-kit/cloud/snowflake/README.md).
SNOWFLAKE_ACCOUNT=
# Your Snowflake user name (SELECT CURRENT_USER();).
SNOWFLAKE_USER=
# Full path to your private key file. dbt does not expand ~, so write the whole path,
# for example C:/Users/<you>/snowflake-keys/gitpulse_key.p8
SNOWFLAKE_PRIVATE_KEY_PATH=
