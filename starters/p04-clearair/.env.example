# ClearAir settings. Copy this file to .env and fill it in: cp .env.example .env
# .env is never committed. Write each value with no quotes and no spaces around "=".

# Task 8: the OpenAQ API. OPENAQ_API_URL is the host only: the code adds /v3/...
# CITY_NAME is a label for your logs: join two words with a hyphen (New-Delhi).
# uv stops reading .env at a value with a space, and every setting after it is lost.
OPENAQ_API_URL=https://api.openaq.org
OPENAQ_API_KEY=
CITY_NAME=
CITY_COORDINATES=
CITY_RADIUS_M=25000
PARAMETER=pm25
MAX_SENSORS=5

# Task 10: your clearair database in the data lab.
DATABASE_URL=postgresql://de:de@localhost:5432/clearair

# Task 11: how far back a first run reads, and the overlap for late data.
START_DAYS=7
LOOKBACK_HOURS=3

# Task 21: the kit's station database.
STATIONDB_URL=postgresql://source:source@localhost:5433/stationdb

# Task 12: a practice switch. Never keep it in .env; set it for one run only:
#   CLEARAIR_FAIL_AFTER_CALLS=3 uv run --env-file .env python -m clearair.cli load-api
# CLEARAIR_FAIL_AFTER_CALLS=3
