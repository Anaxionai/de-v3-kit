# CareLine's settings. Copy this file to .env and fill in your own values. Never commit .env.
# Save .env with LF line endings, or Airflow reads every value with an invisible extra character.
#
# The data lab's PostgreSQL host. On your laptop it is localhost (the default in careline/db.py);
# inside Airflow the kit's compose.yaml sets host.docker.internal itself.
# DATALAB_DB_HOST=localhost
#
# Task 9: the extra Python packages Airflow installs when it starts.
_PIP_ADDITIONAL_REQUIREMENTS="great_expectations pyyaml pandas psycopg[binary]"
#
# Task 11: the salt for patient_key. Put a real random value in .env only.
CARELINE_SALT=change-me
